# Backend runtime
PORT=8080
SERVER_ADDRESS=0.0.0.0
SPRING_PROFILES_ACTIVE=prod
SHUTDOWN_TIMEOUT=20s

# Allowed browser origins. Comma-separated; Spring origin patterns are supported.
AIO_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,https://adaptive-ai-orchestrator.vercel.app,https://*.vercel.app

# Adaptive routing policy
AIO_MAX_ACCEPTABLE_COST_USD=0.25
AIO_MIN_CONFIDENCE_THRESHOLD=0.72
AIO_MAX_ACCEPTABLE_LATENCY_MS=5500
AIO_MAX_RETRIES=1

# Operational logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_AIO=INFO

# Frontend build variable (set this in Vercel)
VITE_API_BASE_URL=https://adaptive-ai-orchestrator.onrender.com
